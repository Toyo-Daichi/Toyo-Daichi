# .bashrc
# zsh (zshrc + p10k) が主。chsh できない環境で bash を使うとき用の最小構成

# 非対話シェルでは何もしない
case $- in
  *i*) ;;
  *) return ;;
esac

# basic PATH
export PATH="$HOME/bin:/usr/local/bin:$PATH"
export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"

# custom PATH
# export PATH = 

# history
HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL=ignoredups
shopt -s histappend

# PS1 (git ブランチは git-prompt があれば表示)
for f in /usr/local/etc/bash_completion.d/git-prompt.sh /usr/lib/git-core/git-sh-prompt; do
  [ -f "$f" ] && source "$f" && break
done
if declare -F __git_ps1 >/dev/null; then
  export GIT_PS1_SHOWDIRTYSTATE=true
  git_ps1='$(__git_ps1)'
else
  git_ps1=
fi
#default:cyan / root:red
if [ "$UID" -eq 0 ]; then
  PS1='\u@\[\033[31m\]\h\[\033[00m\]:\[\033[01m\]\w\[\033[31m\]'"$git_ps1"'\[\033[00m\]\$ '
else
  PS1='\u@\[\033[36m\]\h\[\033[00m\]:\[\033[01m\]\w\[\033[31m\]'"$git_ps1"'\[\033[00m\]\$ '
fi
unset git_ps1 f

# aliases
if [ -f "$HOME/.aliases" ]; then
  source "$HOME/.aliases"
fi
